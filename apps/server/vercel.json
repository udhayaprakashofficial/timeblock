{
  "installCommand": "cd ../.. && npm install --include=dev",
  "buildCommand": "cd ../.. && npm run build -w @timeblock/server",
  "functions": {
    "api/[[...path]].js": {
      "maxDuration": 60,
      "includeFiles": "{dist/**,prisma/**,../../node_modules/.prisma/**,../../node_modules/@prisma/client/**}"
    }
  }
}
