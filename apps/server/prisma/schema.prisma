generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CalendarProvider {
  google
  microsoft
}

enum TaskStatus {
  pending
  in_progress
  completed
}

model User {
  id           String   @id @default(cuid())
  clerkId      String?  @unique
  name         String
  email        String   @unique
  /// scrypt$hash — set for email/password accounts
  passwordHash String?
  theme        String   @default("dark") // light | dark — UI preference in DB
  /// IANA timezone from geography (e.g. Asia/Kolkata), not a fixed offset
  timezone     String   @default("UTC")
  /// Default estimated duration for new auto-scheduled tasks
  defaultTaskMinutes Int @default(30)
  /// False until first-time onboarding finishes (or is skipped)
  onboardingCompleted Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  oauthAccounts  OAuthAccount[]
  templates      DailyScheduleTemplate[]
  tasks          Task[]
  calendarEvents CalendarEvent[]
  sessions       Session[]
  recurringTasks RecurringTaskTemplate[]
}

model Session {
  id        String   @id @default(cuid())
  sid       String   @unique
  data      String
  expiresAt DateTime
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model OAuthAccount {
  id                    String           @id @default(cuid())
  userId                String
  provider              CalendarProvider
  providerAccountId     String
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  expiresAt             DateTime?
  scope                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model DailyScheduleTemplate {
  id        String   @id @default(cuid())
  userId    String
  weekday   Int
  workStart String
  workEnd   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  breaks Break[]

  @@unique([userId, weekday])
}

model Break {
  id         String @id @default(cuid())
  templateId String
  name       String
  start      String
  end        String

  template DailyScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Task {
  id               String     @id @default(cuid())
  userId           String
  date             DateTime   @db.Date
  name             String
  estimatedMinutes Int
  status           TaskStatus @default(pending)
  order            Int
  scheduledStart   DateTime?  @db.Timestamptz(3)
  scheduledEnd     DateTime?  @db.Timestamptz(3)
  /// When set, this task was created from a calendar event (Google Meet, etc.)
  sourceProvider   String?
  sourceExternalId String?
  meetLink         String?
  /// Fixed calendar meetings — packer must not move them
  scheduleLocked   Boolean    @default(false)
  /// Waiting for a future day (no free slot today, or carried over unfinished)
  inBacklog        Boolean    @default(false)
  /// Free-form comments for future review
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@unique([userId, sourceProvider, sourceExternalId])
  @@index([userId, date])
  @@index([userId, inBacklog])
}

/// Daily / weekly repeating task definitions — materialized into Task rows per day.
model RecurringTaskTemplate {
  id               String   @id @default(cuid())
  userId           String
  name             String
  estimatedMinutes Int
  /// Weekdays as JSON number[] — 0=Sun … 6=Sat
  weekdays         Json
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model TimeEntry {
  id            String    @id @default(cuid())
  taskId        String
  startedAt     DateTime
  endedAt       DateTime?
  actualMinutes Int?
  createdAt     DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id         String           @id @default(cuid())
  userId     String
  provider   CalendarProvider
  externalId String
  title      String
  start      DateTime @db.Timestamptz(3)
  end        DateTime @db.Timestamptz(3)
  /// Google Meet / Teams join URL when the calendar event has a conference
  meetLink   String?
  updatedAt  DateTime         @updatedAt
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, externalId])
  @@index([userId, start, end])
}
